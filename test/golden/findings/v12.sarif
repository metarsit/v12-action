            {
              "id": "v12/critical/reentrancy-in-withdraw-lets-a-caller-drain-the-v-4a96f6",
              "name": "ReentrancyInWithdrawLetsACallerDrainTheVault",
              "shortDescription": {
                "text": "Reentrancy in withdraw() lets a caller drain the vault"
              },
              "fullDescription": {
                "text": "`withdraw()` sends ETH with `call` before updating `balances[msg.sender]`, so a malicious receiver can re-enter and withdraw repeatedly."
              },
              "helpUri": "https://v12.sh/runs/42/101",
              "help": {
                "text": "`withdraw()` sends ETH with `call` before updating `balances[msg.sender]`, so a malicious receiver can re-enter and withdraw repeatedly.\n\nImpact: Complete loss of vault funds.\n\nRoot cause: State update happens after the external call (checks-effects-interactions violated).",
                "markdown": "`withdraw()` sends ETH with `call` before updating `balances[msg.sender]`, so a malicious receiver can re-enter and withdraw repeatedly.\n\n**Impact**\n\nComplete loss of vault funds.\n\n**Root cause**\n\nState update happens after the external call (checks-effects-interactions violated).\n\n[View on V12](https://v12.sh/runs/42/101)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "critical",
                  "security",
                  "v12"
                ],
                "security-severity": "9.5"
              }
            },
